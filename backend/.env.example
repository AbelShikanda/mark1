# WhatsApp Marketing Bot config

REPORT_TO=abelshikanda3@gmail.com

# API
API_HOST=127.0.0.1
API_PORT=8000

# WhatsApp session (keep out of git)
WHATSAPP_SESSION_DIR=whatsapp_session

# Storage
DB_PATH=data/marketing.db

# Anti-detection delays (seconds)
POST_MIN_DELAY=6
POST_MAX_DELAY=15
BATCH_PAUSE_SECONDS=5

# A group is silenced after this many consecutive misses. Can also be changed
# from the dashboard (Settings page); the database setting wins over this value.
MAX_GROUP_MISSES=10

# Page-interaction timings (seconds). These mirror the reference poster's
# CONFIGURATION block and can also be changed from the Settings page.
SEARCH_WAIT=1
OPEN_WAIT=1
FIND_COMPOSE_WAIT=1
AFTER_TYPING_WAIT=1
SEND_CONFIRM_WAIT=1
RETRY_DELAY=2
LINK_PREVIEW_DELAY=6
TYPING_DELAY_MIN=12
TYPING_DELAY_MAX=28

# Playwright browsers path (auto-detected if omitted; set to override)
# PLAYWRIGHT_BROWSERS_PATH=C:\Users\PRINT SHOP\AppData\Local\ms-playwright
